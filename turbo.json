{
  "$schema": "https://turbo.build/json-schema.json",
  "ui": "tui",
  "globalDependencies": [".env*", "tsconfig.json"],
  "tasks": {
    "dev": {
      "cache": false,
      "interactive": true
    },
    "build": {
      "outputs": ["dist/**", "build/**", ".next/**"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": [".eslintcache"],
      "cache": true
    }
  }
}
