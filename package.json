{
  "name": "esign-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @esign/web dev",
    "dev:web:turbo": "pnpm --filter @esign/web dev:turbo",
    "dev:api": "pnpm --filter @esign/api dev",
    "build": "node scripts/build.js",
    "start": "pnpm run db:migrate:deploy && pnpm --filter @esign/api start",
    "start:web": "pnpm --filter @esign/web start",
    "lint": "turbo lint",
    "clean": "pnpm run clean:logs && pnpm run clean:next && pnpm run clean:turbo",
    "clean:logs": "node scripts/clean.js logs",
    "clean:next": "node scripts/clean.js next",
    "clean:turbo": "node scripts/clean.js turbo",
    "db:migrate": "pnpm --filter @esign/db migrate",
    "db:migrate:deploy": "pnpm --filter @esign/db migrate:deploy",
    "db:generate": "pnpm --filter @esign/db generate",
    "db:studio": "pnpm --filter @esign/db studio",
    "postinstall": "pnpm --filter @esign/db run generate"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.34.0",
    "turbo": "^2.9.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "7.6.0",
    "@types/next-auth": "^3.15.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.18",
    "next-auth": "^4.24.13",
    "prisma": "7.6.0",
    "speakeasy": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.16.0",
      "@hono/node-server": "1.19.13",
      "fast-uri": "3.1.2",
      "fast-xml-builder": "1.2.0",
      "fast-xml-parser": "5.7.0",
      "follow-redirects": "1.16.0",
      "glob": ">=10.5.0",
      "hono": "4.12.23",
      "next": "16.2.6",
      "postcss": "8.5.10",
      "qs": "6.15.2",
      "uuid": "11.1.1",
      "ws": "8.20.1"
    }
  }
}
